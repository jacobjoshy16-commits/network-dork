# Documentation only: this file is not automatically loaded.
# Environment variables override YAML configuration.
NETWORK_DORK_CONFIG=config/default.yaml

NETWORK_DORK_OLLAMA_BASE_URL=http://127.0.0.1:11434
NETWORK_DORK_MODEL=qwen2.5:3b-instruct
NETWORK_DORK_TEMPERATURE=0
NETWORK_DORK_TIMEOUT_SECONDS=120
NETWORK_DORK_MAX_ATTEMPTS=3
NETWORK_DORK_NUM_CTX=8192
NETWORK_DORK_NUM_PREDICT=2048
NETWORK_DORK_MAX_INPUT_CHARS=32000
NETWORK_DORK_MAX_RESPONSE_BYTES=1048576

NETWORK_DORK_OPENSEARCH_BASE_URL=http://127.0.0.1:9200
NETWORK_DORK_OPENSEARCH_ALERTS_INDEX=security-alerts-*
NETWORK_DORK_OPENSEARCH_FLOWS_INDEX=network-flows-*
NETWORK_DORK_OPENSEARCH_DNS_INDEX=dns-*
NETWORK_DORK_OPENSEARCH_AUTH_INDEX=auth-*
NETWORK_DORK_OPENSEARCH_REPORTS_INDEX=network-dork-reports
NETWORK_DORK_OPENSEARCH_TIMEOUT_SECONDS=30
NETWORK_DORK_OPENSEARCH_MAX_HITS=500
NETWORK_DORK_OPENSEARCH_MAX_RESPONSE_BYTES=1048576

NETWORK_DORK_CONTEXT_WINDOW_DAYS=7
NETWORK_DORK_ALERTS_PATH=fixtures/alerts/alerts.jsonl
NETWORK_DORK_ZEEK_DIRECTORY=fixtures/zeek

NETWORK_DORK_STATE_PATH=var/state.sqlite3
NETWORK_DORK_REPORTS_PATH=var/reports.sqlite3
NETWORK_DORK_AUDIT_PATH=var/audit.jsonl

NETWORK_DORK_ALERT_ADAPTER=file
NETWORK_DORK_CONTEXT_ADAPTER=zeek_logs
NETWORK_DORK_LLM_ADAPTER=ollama
NETWORK_DORK_SINK_ADAPTER=sqlite

# Distinct credentials. Telemetry credentials must not be able to write reports.
NETWORK_DORK_TELEMETRY_USERNAME=
NETWORK_DORK_TELEMETRY_PASSWORD=
NETWORK_DORK_REPORT_USERNAME=
NETWORK_DORK_REPORT_PASSWORD=
