# Environment variables override YAML settings.
# This file is documentation, not automatically loaded.
NETWORK_DORK_CONFIG=config/default.yaml
NETWORK_DORK_MODEL=qwen2.5:3b-instruct
NETWORK_DORK_TEMPERATURE=0
NETWORK_DORK_TIMEOUT_SECONDS=120
NETWORK_DORK_CONTEXT_WINDOW_DAYS=7
NETWORK_DORK_ALERTS_PATH=fixtures/alerts/alerts.jsonl
NETWORK_DORK_ZEEK_DIRECTORY=fixtures/zeek
NETWORK_DORK_MAX_ATTEMPTS=3

# Separate identities; never reuse these credentials.
# OpenSearch is optional and is not needed for the fixture path.
NETWORK_DORK_TELEMETRY_USERNAME=
NETWORK_DORK_TELEMETRY_PASSWORD=
NETWORK_DORK_REPORT_USERNAME=
NETWORK_DORK_REPORT_PASSWORD=
